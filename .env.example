# ---------------------------------------------------------------------------
# NIHCC 胸部X線画像検索ローカルRAGシステム / 環境設定サンプル
# cp .env.example .env して利用する。.env は Git へ commit しない。
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=nihcc-rag
# コンテナのタイムゾーン。ログの時刻表示に効く。
TZ=Asia/Tokyo
# RabbitMQ の利用者名（パスワードは secrets/rabbitmq_password.txt）
RABBITMQ_USER=nihcc
# embedding-service を PyTorch 入りでビルドするか。false では deterministic
# backend だけが使える（モデルを取得できない閉域での検証用）。
WITH_TORCH=true
# 評価用 override（infra/compose/docker-compose.eval.yml）で embedding-service を
# ホストへ公開するポート。評価中だけ使い、終わったら override を外すこと。
# **番号だけを書く。** override 側が 127.0.0.1: を付けるので、ここにも書くと
# 127.0.0.1:127.0.0.1:8002 になり、compose が build も含めて全部失敗する。
EMBEDDING_SERVICE_PORT=8002
# 同じ override で roi-service をホストへ公開するポート（番号だけを書く）。本番の取り込み
# 経路が評価と同じ特徴を作るかの検査（chest_image_eval.py verify-ingest）に使う。
# roi-service が 1 台（ROI_SERVICE_REPLICAS=1）のときだけ公開できる。
ROI_SERVICE_PORT=8001
# 同じ override で metadata-db をホストへ公開するポート。評価結果を DB へ残すのに
# 使う（評価スクリプトは cv2 が要るのでコンテナ内では動かせない。
# docs/OPERATIONS.md §6.3）。**loopback だけに開くこと。**
METADATA_DB_PORT_HOST=55432

# NIHCC データセットの配置場所（compose ファイルからの相対パス、または絶対パス）
# 画像 : ${NIHCC_DATA_DIR}/images/*.png
# CSV  : ${NIHCC_DATA_DIR}/Data_Entry_2017_v2020.csv
# コンテナ内では /imports/nihcc に read-only でマウントされる。
NIHCC_DATA_DIR=./NIHCC

# ---- 公開ポート（ホスト側） -------------------------------------------------
FRONTEND_PORT=8080
BACKEND_API_PORT=8000
RABBITMQ_UI_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- 認証（ローカル IdP） ---------------------------------------------------
# 本番相当環境では OIDC の外部 IdP に置き換える。
JWT_ISSUER=nihcc-rag-local
JWT_AUDIENCE=nihcc-rag-api
JWT_TTL_SECONDS=28800
# 初期ユーザー: "user:password:role" をカンマ区切り。role は viewer|operator|admin。
LOCAL_USERS=admin:admin-change-me:admin,operator:operator-change-me:operator,viewer:viewer-change-me:viewer

# ---- モデル ---------------------------------------------------------------
# biomedclip   : Microsoft BiomedCLIP を OpenCLIP でロードする（既定）
# deterministic: モデル取得不可な閉域/検証環境向けの決定論的スタブ encoder
#                （512次元・L2正規化。医学的意味は持たないため評価には使用しない）
EMBEDDING_BACKEND=biomedclip
EMBEDDING_MODEL_ID=hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
# 検証済み commit revision を必ず固定する（main は使わない）
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSION=512

# ---- 2 段ベクトル検索（coarse -> fine）------------------------------------
# 1 段目: EMBEDDING_DIMENSION 次元の embedding（HNSW index）で候補を近似探索
# 2 段目: EMBEDDING_FINE_DIMENSION 次元の embedding_fine で候補だけを厳密に再計算
#
# 既定は無効（EMBEDDING_FINE_BACKEND=none）。有効化する前に次の 2 点を理解すること。
#
#  1) 精度向上は「fine 側が別の、より強いモデルであること」からのみ得られる。
#     512 次元から決定論的に作った 1024 次元には情報が増えないため、順位は変わらず
#     計算量だけが増える。BiomedCLIP は共通 512 次元空間しか持たないので、
#     fine には別モデル（または 2 モデルの連結）が必要である。
#  2) 別モデルを足すと 1 回の検索で推論が 2 回になる。CPU 機では BiomedCLIP の
#     推論が検索時間の支配項であり、検索時間はおおよそ倍になる。GPU 前提で導入すること。
#
# 速度について: 2 段検索が速いのは「高次元を HNSW で直接索引する」構成との比較で
# あり、現在の 1 段（512 次元 HNSW）より速くなるわけではない。2 段目の利点は
# 最終順位が近似 ANN ではなく厳密計算になること、および索引が低次元のまま
# （build 時間・メモリが増えない）ことである。
#
# none         : 無効。1 段検索のみ（既定）
# deterministic: 決定論的スタブ。配線と DB スキーマの動作確認用。医学的意味は無い
# chest-profile: **採用構成**。胸部野の分類器が出す所見プロファイル
#                （14 所見の確率 + 正常らしさ = 15 次元）。backbone（RAD-DINO）で
#                画像を 1 回順伝播し、patch token を胸部野 mask で pooling して、
#                CHEST_HEAD_PATH の分類器で 15 次元へ落とす。確率は画面の
#                「所見の推定」にも使う。EMBEDDING_FINE_DIMENSION=15 に合わせること。
#                全量の評価で画像単位 AUC 0.833、Test B は 14 所見すべてで lift 1.33 以上。
#                **backbone の revision を EMBEDDING_FINE_MODEL_REVISION で固定する。**
#                分類器はその重みの特徴で学習しているので、起動時に成果物と照合し、
#                違えば起動を止める。
# rad-dino     : microsoft/rad-dino。胸部X線特化の DINOv2 系 image encoder。
#                **768 次元**なので EMBEDDING_FINE_DIMENSION=768 に合わせること。
#                text encoder を持たないため、TEXT_TO_IMAGE / HYBRID では 2 段目が
#                自動的に無効になる（画像モードのみ 2 段）。
#                ライセンス MIT / 無料。公開元は「研究目的のみ・臨床実践での使用を
#                意図しない」と明記している。
# biomedclip   : OpenCLIP 経由の別モデル。EMBEDDING_FINE_MODEL_ID を必ず指定する
EMBEDDING_FINE_BACKEND=none
# embedding_fine 列の幅。fine を無効にしていても列は作られる（全行 NULL）。
# chest-profile なら 15（14 所見 + 正常らしさ）、rad-dino 単体なら 768。
# **migration 実行時に固定される。** 変更後は db/vector-migrations に新しい V00x を
# 追加して適用し直す必要がある（適用済み migration の checksum 変更は拒否される）。
EMBEDDING_FINE_DIMENSION=15
# 胸部野の分類器（scripts/export_chest_head.py で作る）。read-only で mount する。
CHEST_HEAD_PATH=/models/chest/head-pool-chest.npz
# 分類器と backbone の revision が固定されていなくても起動させるか。**本番では false。**
# 手元の動作確認で、版を控えていない分類器を試すときだけ true にする（警告が出る）。
CHEST_HEAD_ALLOW_UNPINNED=false
EMBEDDING_FINE_BACKBONE=rad-dino
EMBEDDING_FINE_BACKBONE_DIMENSION=768
# 肺野全体の形状ベクトルの次元（nihcc_rag.shape.LUNG_DIMENSION と揃える）。
# migration 実行時に embedding_lung の列幅として固定される。
EMBEDDING_LUNG_DIMENSION=16
# 胸部野 mask pooling が 1 回に順伝播する画像数。518 四方は token が 1,369 個あり
# 224 四方の約 7 倍で、attention は token 数の 2 乗に効く。上の batch とは別に持つ。
EMBEDDING_POOL_BATCH_SIZE=8
# 胸部野の分類器を置くホスト側ディレクトリ。compose が /models/chest へ read-only で
# mount する。追跡ディレクトリにしているのは、tmp/ を既定にすると docker compose が
# root 所有で作ってしまい、その後の書き出しが permission denied になるため。
CHEST_HEAD_DIR=./infra/chest
# 肺野分割モデル（U-Net）を置くホスト側ディレクトリ。compose が /models/lung-unet へ
# read-only で mount する。
LUNG_MODEL_DIR=./infra/lung-unet
EMBEDDING_FINE_MODEL_ID=
EMBEDDING_FINE_MODEL_REVISION=
# プロセス内に持つ fine モデル数。coarse と合わせて vCPU を超えないこと
EMBEDDING_FINE_MODEL_REPLICAS=1
EMBEDDING_BATCH_SIZE=32
# 埋め込み推論の並列度。g5.2xlarge の推奨値は SETUP_EC2.md §8.3。
#   CPU 機: モデル数 x torch スレッド数 <= vCPU（ROI と DB のぶんを 2 コアほど残す）
#   GPU 機: モデル数 1 で足りる（1 回の順伝播が数ミリ秒のため）
# 既定は g5.2xlarge（8 vCPU / A10G）を想定した値。
EMBEDDING_MODEL_REPLICAS=1
EMBEDDING_TORCH_THREADS=4
# cuda 指定で GPU が無い場合は警告のうえ CPU へ自動フォールバックする。
# GPU を実際に使うには COMPOSE_FILE へ infra/compose/docker-compose.gpu.yml を足す。
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
# torch の取得元。CPU 機では .../whl/cpu に戻して再ビルドする。
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
MAX_TEXT_TOKENS=256
MODEL_WARMUP_BATCHES=3
INFERENCE_TIMEOUT_MS=5000
HYBRID_IMAGE_WEIGHT=0.70
# 完全 offline 実行にする場合は 1（モデル cache が /models/hf-cache に必要）
HF_HUB_OFFLINE=0

# ---- 胸部野の抽出 ---------------------------------------------------------
# nihcc-unet-local-v1 : CheXmask を教師に学習した U-Net（160px。評価に使ったもの）
# nihcc-unet-v1       : 同・本番用の 384px（docs/runbooks/lung-unet.md）
#
# **U-Net が必須。** 胸部野（肺野＋縦隔＋横隔膜）には心臓の mask が要り、規則ベース
# （nihcc-classical-v1）は心臓を出さない。roi-service は起動時に止まる。
# 胸部野の分類器は評価に使った profile を前提にしているので、変えるなら分類器も
# 学習し直す（ingest-worker が起動時に突き合わせる）。
ROI_PROFILE=nihcc-unet-local-v1
ROI_MIN_CONFIDENCE=0.35
# 埋め込み crop の作り方を変えたら上げる（版の違うベクトルと混ざらないようにするため）。
# prep-v1.1.0: ROI 側で crop を短辺 224 へ縮小してから符号化する。
PREPROCESS_VERSION=prep-v1.1.0

# ---- 並列度 ---------------------------------------------------------------
# 取り込みワーカー数。GPU 機では ROI 抽出（CPU）が律速になるため、vCPU に対して
# 多めに置いて ROI を並行させる。g5.2xlarge の値は SETUP_EC2.md §8.3。
INGEST_WORKER_REPLICAS=6
# ROI 抽出サービスのコンテナ数。GPU 機で stage="roi" が律速なら 2 へ上げる。
ROI_SERVICE_REPLICAS=1
# 埋め込み用 crop を DB へ保存するか。false なら画面表示は原画像 + mask から合成する
# （11 万件で約 16GB の書き込み削減）。
INGEST_STORE_REGION_CROPS=false
INGEST_WORKER_PREFETCH=4
SEARCH_WORKER_REPLICAS=1
# search-worker が queue から一度に取る数。増やすと遅い検索が後続を待たせる。
SEARCH_WORKER_PREFETCH=2
INGEST_BATCH_SIZE=200

# ---- 検索既定値 -----------------------------------------------------------
DEFAULT_TOP_K=10
MAX_TOP_K=100
MAX_CANDIDATE_K=500
HNSW_EF_SEARCH=100
# 2 段検索の 1 段目で candidate_k の何倍まで候補を取るか。再ランキングの効果は
# 1 段目の recall が上限になる。倍率を上げると厳密解に近づくが 1 段目の探索と
# 2 段目の距離計算が増える。ef_search は 1 段目の取得件数まで自動的に引き上げる。
VECTOR_STAGE1_MULTIPLIER=4
# 1 段目の取得件数の上限。pgvector の hnsw.ef_search 上限（1000）を超えられない
VECTOR_STAGE1_MAX_LIMIT=1000
# 2 段目に残しておく最低の timeout 予算(ms)。1 段目で使い切った場合は 2 段目を
# 諦め、1 段目の結果を rerank_status=BUDGET_EXHAUSTED として返す
VECTOR_STAGE2_MIN_BUDGET_MS=200
# 画像だけの検索の進め方。
#   profile: 所見プロファイル（15 次元）で全件を厳密に検索する（既定）
#   coarse_to_fine: BiomedCLIP で候補を集めてから所見プロファイルで並べ替える
# テキストを含む検索は常に BiomedCLIP から。切り替えは値を変えて up -d（build 不要）
IMAGE_SEARCH_STRATEGY=profile
# ベクトル検索 1 回の照会の上限(ms)。PostgreSQL の statement_timeout として効く。
# 超えた場合は 504 SEARCH_TIMEOUT を返す（503 ではない。
# 「遅い」と「落ちている」は対処が正反対のため区別する）。
# ローカルで重いビルドやテストと並行して使うと 2000 では足りないことがある。
# 有効範囲は 100〜60000。範囲外は丸められ、警告がログに出る。
VECTOR_QUERY_TIMEOUT_MS=2000
# iterative_scan が 1 回の検索で走査する行数の上限。絞り込み条件に一致する行が
# 少ないほど走査が伸びるため、ここが実質的な照会時間の上限を決める。
HNSW_MAX_SCAN_TUPLES=20000
# ベクトル用 Citus クラスタの shard 数。**migration 実行時に固定される。**
# Worker 5 台に 6 個ずつ均等に載る 30 にしている（24 だと 5,5,5,5,4 と偏る）。
# 変更するには分散テーブルを作り直す必要がある。
CITUS_SHARD_COUNT=30
# ベクトル用クラスタのイメージ（infra/postgres/Dockerfile.citus-pgvector でビルド）
# PostgreSQL のメジャー版。**metadata とベクトル用クラスタが同じ版を使う。**
# 上げるときは docs/OPERATIONS.md §8 の手順で dump / restore が要る
# （メジャーバージョンアップはデータファイルの互換性が無い）。
# 上限は Citus が決める。2026-09 時点で citusdata/citus に pg18 版は無い。
PG_MAJOR=17
CITUS_VERSION=14.2.0
PGVECTOR_VERSION=0.8.6
CITUS_PGVECTOR_IMAGE=local/citus-pgvector:14.2.0-pg17-v0.8.6
# 依存サービス呼び出しの上限。GPU 推論なら 5000 で足りる。
# CPU 推論では推論だけで数秒かかるため既定を広げている。
API_SEARCH_TIMEOUT_MS=30000
SEARCH_ASYNC_THRESHOLD_MS=2000

# ---- アップロード制限 ------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
QUERY_IMAGE_RETENTION_MINUTES=60

# ---- ログ -----------------------------------------------------------------
LOG_LEVEL=INFO

# ---- ユーザー管理・メール ---------------------------------------------------
# 画面の公開 URL（パスワード再設定メールのリンク生成に使用）
APP_BASE_URL=http://localhost:8080
# 初回起動時、利用者が 0 件のときだけ LOCAL_USERS から作る初期ユーザーのメールドメイン
BOOTSTRAP_EMAIL_DOMAIN=local.example
MAIL_ENABLED=1
MAIL_FROM=no-reply@local.example
MAIL_FROM_NAME=NIHCC RAG
# 既定はローカル検証用 SMTP（mailpit）。組織のリレーを使う場合は差し替える。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_STARTTLS=0
SMTP_USE_SSL=0
MAILPIT_UI_PORT=8025
